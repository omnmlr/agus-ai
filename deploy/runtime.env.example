# /etc/agus-ai/runtime.env
# Keep the real file outside Git, mode 0600. Values are raw, without quotes.
# Use a separate database project and an AGUS AI service login. The URI must use sslmode=verify-full.
AGUS_DATABASE_URL=
AGUS_PROVIDER_BOOTSTRAP_TOKEN=
# Distribute separately from the runner enrollment token.
AGUS_REGISTRATION_TOKEN=
AGUS_DEVNET_RPC_URL=https://api.devnet.solana.com

# Enable only with the Compose settlement override and a disposable Devnet operator.
AGUS_SETTLEMENT_ENABLED=0
# AGUS_SETTLEMENT_KEYPAIR_FILE=/run/agus-ai/settlement-keypair.json
# AGUS_SETTLEMENT_RPC_URL=https://api.devnet.solana.com
